{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanada.ai/contracts/graph-verified-change/stage-evidence.v1.json",
  "title": "StageEvidence/v1",
  "description": "Exact-head stage delivery evidence under externally adopted DEC-AUP-0167. Process references are accepted only when their committed native canary plans, measured source inputs, and verified entity rows bind them; caller-supplied semantic scope labels are not accepted. This document carries no authority or adoption claim; the native gate binds the external decision independently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage_id", "repository", "raw_car_sha256", "changed_paths", "nm_entities", "e2e_runs", "path_coverage", "entity_coverage", "pull_request"],
  "properties": {
    "schema": {"const": "StageEvidence/v1"},
    "stage_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "base", "head"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "raw_car_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "changed_paths": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "status"],
        "properties": {"path": {"type": "string", "minLength": 1}, "status": {"enum": ["A", "M", "D"]}}
      }
    },
    "nm_entities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entity", "reason"],
        "properties": {"entity": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
      }
    },
    "e2e_runs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "result_ref", "probe_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result_ref": {"type": "string", "minLength": 1},
          "probe_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "path_coverage": {
      "type": "array", "items": {"$ref": "#/$defs/pathCoverage"}
    },
    "entity_coverage": {
      "type": "array", "items": {"$ref": "#/$defs/entityCoverage"}
    },
    "pull_request": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "review_comment_id"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "review_comment_id": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "pathCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "entityCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["entity", "evidence"],
      "properties": {
        "entity": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
