# Environment variables the `arcana` binary, its tests and its dev-tools read.
#
# NAMES ONLY. This file never carries a value: secrets are delivered by the host
# (key files, systemd credentials) and every default lives in the code at the
# location cited. Copying this file to `.env` does nothing — `arcana` does not
# load dotenv files; export the variables you need in the shell or the unit.
#
# Graph admission (`v-config-schema`, DEC-AUP-0008) reads this file as the
# repository's env source: every key the code reads must be named here.
# `dev-tools/check-env-declared.py` enforces the same rule in CI, including
# reads through a `const` name, which the graph verifier does not resolve.
#
# required   = the feature that reads it fails without it
# optional   = unset means the built-in default

# ---- Model Connector ------------------------------------------------------------
# required for any model call (MissingApiKey otherwise). crates/connectors/src/model_connector.rs:389
ARCANA_MC_TOKEN=
# optional, default in crates/connectors/src/model_connector.rs:14
ARCANA_MC_BASE_URL=
# optional, whole-request timeout in seconds, default in crates/connectors/src/model_connector.rs:69
ARCANA_MC_TIMEOUT_SECS=
# optional, connect timeout in seconds, default in crates/connectors/src/model_connector.rs:39
ARCANA_MC_CONNECT_TIMEOUT_SECS=
# optional, model id; precedence flag > env > config file. crates/cli/src/models.rs:296
ARCANA_MODEL=
# required for `arcana usage` only (purpose-scoped stats token). crates/cli/src/usage.rs:363
ARCANA_STATS_TOKEN=

# ---- Auth Arcana -----------------------------------------------------------------
# optional, OIDC issuer for `arcana login`, default in crates/cli/src/login.rs:27
ARCANA_AUTH_ISSUER=
# optional, client-credentials token endpoint, default in crates/connectors/src/auth_arcana.rs:24
ARCANA_AUTH_TOKEN_URL=
# path to the KB client secret file; one of this or CREDENTIALS_DIRECTORY is required
# for the production skill source. crates/connectors/src/auth_arcana.rs:80
ARCANA_KB_CLIENT_SECRET_FILE=
# set by systemd (LoadCredential=); fallback for the secret file above. crates/connectors/src/auth_arcana.rs:83
CREDENTIALS_DIRECTORY=

# ---- Knowledge / work items ------------------------------------------------------
# optional, Scrutator base URL, default in crates/connectors/src/scrutator.rs:23
ARCANA_SCRUTATOR_URL=
# optional: production (default) | bootstrap. crates/skills/src/source.rs:80
ARCANA_SKILLS_SOURCE=
# optional, Muneral base URL, default in crates/connectors/src/muneral.rs:25
ARCANA_MUNERAL_URL=
# required for the Muneral connector: path to the key file. crates/connectors/src/muneral.rs:110
ARCANA_MUNERAL_KEY_FILE=
# optional; unset disables the Argana contract source. crates/connectors/src/contract_source.rs:76
ARCANA_ARGANA_URL=
# optional; unset leaves the Ops Bot notifier without a token. crates/connectors/src/ops_bot.rs:83
ARCANA_OPS_BOT_TOKEN=

# ---- Tools and permissions -------------------------------------------------------
# optional, path to the coworker binary (default resolved under HOME). crates/connectors/src/coworker.rs:179
ARCANA_COWORKER_BIN=
# optional, host allowlist for webfetch when no rule layer is wired. crates/tools/src/webfetch.rs:185
ARCANA_WEBFETCH_ALLOW_HOSTS=
# optional, permission prompt timeout in seconds (0 = wait forever),
# default in crates/cli/src/permission_prompt.rs:84
ARCANA_PROMPT_TIMEOUT_SECS=
# optional: allow | deny; unset = ask. crates/core/src/permission/interactive.rs:67, crates/cli/src/run.rs:712
ARCANA_PERMISSION_AUTO=

# ---- Operating system ------------------------------------------------------------
# set by the OS; identity shown by `whoami`/bootstrap. crates/mcp/src/builtins.rs:31, crates/cli/src/bootstrap.rs:181
USER=
USERNAME=

# ---- Tests (live, opt-in) --------------------------------------------------------
# live Scrutator test runs only when set. crates/connectors/tests/live_scrutator.rs:51
ARCANA_SCRUTATOR_TOKEN=
# optional overrides for the live test. crates/connectors/tests/live_scrutator.rs
ARCANA_SCRUTATOR_LIVE_NS=
ARCANA_SCRUTATOR_LIVE_QUERY=
ARCANA_SCRUTATOR_DISCOVER_INTENT=

# ---- dev-tools -------------------------------------------------------------------
# replay server for the smoke test: status code and body file. dev-tools/smoke/mc_replay_server.py:15
MC_STATUS=
MC_BODY_FILE=
