# Permissioned local IPC for the credential broker.
#
# The socket is the ONLY route to provider authority. Its mode is what makes
# authorisation possible at all: the broker reads kernel-supplied peer
# credentials (SO_PEERCRED) from this socket, so peer identity is attested by
# the kernel rather than claimed by the caller.
#
# Group ownership is the executor group, not world. A process outside that group
# cannot even connect, so policy evaluation is a second gate, not the first.

[Unit]
Description=Arcana credential broker socket
Documentation=https://github.com/Arcanada-one/arcana-agent-system

[Socket]
ListenStream=/run/arcana-credential-broker/broker.sock
SocketUser=arcana-broker
SocketGroup=arcana-executor
SocketMode=0660
# One connection at a time keeps peer-credential handling unambiguous.
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
