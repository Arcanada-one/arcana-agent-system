# Arcana credential broker — the sole holder of provider credentials.
#
# The hardening below is not decoration. Each directive closes a specific
# recovery path that the incident proved is real:
#
#   User=/Group=          a separate uid is what makes ptrace and /proc/<pid>/environ
#                         inspection by the agent uid impossible. This is the
#                         primary control; everything else is depth.
#   ProtectProc=invisible other processes are not even visible in /proc, so the
#                         agent cannot enumerate the broker to inspect it.
#   LimitCORE=0           a core dump of this process would contain the
#                         credential in plaintext.
#   ProtectHome=          the agent's config homes are unreachable from here.
#   Environment           deliberately absent: the credential is read from a
#                         mode-0600 file owned by the broker, never from the
#                         environment, so it cannot be inherited by anything.
#
# Deployment is disabled by default: this unit ships but is not enabled.

[Unit]
Description=Arcana credential broker
Documentation=https://github.com/Arcanada-one/arcana-agent-system
Requires=arcana-credential-broker.socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/libexec/arcana/arcana-credential-broker --policy /etc/arcana/credential-broker/capability-policy.toml --credential-source /etc/arcana/credential-broker/provider.key
Restart=on-failure
RestartSec=2s

# --- identity -------------------------------------------------------------
User=arcana-broker
Group=arcana-broker
# The broker must never gain privileges it did not start with.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes

# --- private runtime state ------------------------------------------------
RuntimeDirectory=arcana-credential-broker
RuntimeDirectoryMode=0750
StateDirectory=arcana-credential-broker
StateDirectoryMode=0700

# --- memory and dump protection -------------------------------------------
# A core dump or a writable-executable mapping is a credential disclosure.
LimitCORE=0
MemoryDenyWriteExecute=yes
LockPersonality=yes

# --- filesystem and process isolation -------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ReadOnlyPaths=/etc/arcana/credential-broker
InaccessiblePaths=/home

# --- syscall and network surface ------------------------------------------
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @obsolete @privileged @resources
# AF_UNIX for the local IPC socket; INET for the upstream provider call.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
