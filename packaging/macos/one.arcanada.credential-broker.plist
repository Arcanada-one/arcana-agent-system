<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arcana credential broker — macOS launchd service.

  The macOS equivalent of the Linux hardening, with the same intent:

    UserName            a separately accounted identity. As on Linux, this is
                        the primary control: the agent uid cannot attach to or
                        inspect a process owned by another user.
    SoftResourceLimits  core dumps disabled — a dump would contain the credential.
    ProgramArguments    the credential source is a protected owner-only file,
                        not an environment variable, so nothing can inherit it.

  There is deliberately no EnvironmentVariables block. Adding one would
  reintroduce exactly the channel this service exists to remove.

  Disabled by default: ships with Disabled=true and is enabled only after the
  platform verification checks pass.

  Credentialed startup currently refuses before reading a secret. This plist
  is packaging scaffolding, not proof of XPC audit-token attestation or hostile
  descendant containment. Do not enable it until those macOS gates pass.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>one.arcanada.credential-broker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/arcana/arcana-credential-broker</string>
        <string>--policy</string>
        <string>/etc/arcana/credential-broker/capability-policy.toml</string>
        <string>--credential-source</string>
        <string>/etc/arcana/credential-broker/provider.key</string>
        <string>--state</string>
        <string>/var/db/arcana-credential-broker/broker-state.json</string>
        <string>--audit</string>
        <string>/var/db/arcana-credential-broker/audit.log</string>
        <string>--socket</string>
        <string>/var/run/arcana-credential-broker/broker.sock</string>
    </array>

    <!-- Separately accounted identity. Never the executor account. -->
    <key>UserName</key>
    <string>_arcanabroker</string>
    <key>GroupName</key>
    <string>_arcanabroker</string>

    <key>Disabled</key>
    <true/>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- A core dump would contain the credential in plaintext. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Diagnostics carry status only; the broker never writes secret material. -->
    <key>StandardOutPath</key>
    <string>/var/log/arcana/credential-broker.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/arcana/credential-broker.err</string>
</dict>
</plist>
